{
  "name": "api",
  "version": "1.0.0",
  "description": "Trabajo profesional FIUBA-Garrahan",
  "main": "app.js",
  "type": "module",
  "scripts": {
    "test": "jest --passWithNoTests && cucumber-js --tags \"not @wip\" --import features/step-definitions --import features/support",
    "test:unit": "jest --testPathPattern=spec",
    "cucumber": "DEBUG=testcontainers* cucumber-js --tags \"not @wip\" --import features/step-definitions --import features/support",
    "lint": "eslint .",
    "dev": "nodemon --watch src --ext ts,js --exec node src/app.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "nodemon": "^3.1.10",
    "oracledb": "^6.3.0",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.3",
    "@babel/preset-env": "^7.28.3",
    "@cucumber/cucumber": "^12.2.0",
    "@eslint/js": "^9.31.0",
    "babel-jest": "^30.0.5",
    "eslint": "^9.31.0",
    "eslint-plugin-n": "^17.21.0",
    "globals": "^16.3.0",
    "jest": "^29.7.0",
    "supertest": "^7.1.4",
    "testcontainers": "^11.5.1"
  }
}
